# Copie para .env e substitua por valores locais. Nunca use este exemplo em produção.
PORT=3000
DB_NAME=dcollege_api
DB_USER=dcollege_local
DB_PASS=change-me-locally
DB_HOST=127.0.0.1
DB_DIALECT=mysql
DB_PORT=3306
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Opcional: origem permitida para clientes web (o projeto mantém CORS aberto por padrão).
# CORS_ORIGIN=http://localhost:5173
